# Copy this file to ".env" and fill in your own values.
# (On Render/Railway you set these in the dashboard instead of a file.)

# --- Your Neon database connection string ---
# Get this from neon.tech: open your project > "Connection string" > copy the one that ends with ?sslmode=require
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require

# --- Your owner password (this is how YOU log in to edit) ---
# Pick something only you know. Anyone with this can edit the collection.
ADMIN_PASSWORD=change-this-to-a-strong-password

# --- A random secret used to sign your login cookie ---
# Just mash the keyboard or paste a long random string. Keep it private.
SESSION_SECRET=change-this-to-a-long-random-string

# --- The name shown on your public page (you can also change it in the app) ---
DISPLAY_NAME=Julio

# --- Leave this as production when deployed online ---
NODE_ENV=production

# PORT is set automatically by most hosts. Locally it defaults to 3000.
# PORT=3000
